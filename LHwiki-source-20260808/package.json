{
  "name": "campus-notes",
  "version": "0.9.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:local": "wrangler d1 execute campus-notes-db --local --file=./schema.sql",
    "db:remote": "wrangler d1 execute campus-notes-db --remote --file=./schema.sql",
    "test": "node scripts/run-tests.mjs",
    "stability:check": "node scripts/stability-check.mjs",
    "smoke:functional": "node scripts/functional-smoke.mjs"
  },
  "devDependencies": {
    "@xmldom/xmldom": "^0.9.12",
    "wrangler": "4.119.0"
  }
}
